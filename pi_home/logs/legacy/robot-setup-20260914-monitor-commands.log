tail -n 10 ~/robot-setup-dev-install.log; ps -eo pid,etime,stat,args | grep -E 'apt-get|dpkg|needrestart' | grep -v grep; free -h; cat /sys/class/thermal/thermal_zone0/temp
curl -fsSL --connect-timeout 15 --max-time 60 https://api.github.com/repos/ros-infrastructure/ros-apt-source/releases/latest -o ~/robot-setup-ros-source-release.json; python3 -c 'import json,pathlib; d=json.loads((pathlib.Path.home()/"robot-setup-ros-source-release.json").read_text()); print(d["tag_name"]); [print(a["name"], a["browser_download_url"], a.get("digest")) for a in d["assets"] if "ros2-apt-source_" in a["name"] and "noble_all.deb" in a["name"]]'
curl -fL --connect-timeout 15 --max-time 120 https://github.com/ros-infrastructure/ros-apt-source/releases/download/1.3.0/ros2-apt-source_1.3.0.noble_all.deb -o ~/ros2-apt-source_1.3.0.noble_all.deb; echo 'f31d84adf5054c7d60ded0e82c0f776a77ea33af53d08f40b9ad7c94cca55296  ros2-apt-source_1.3.0.noble_all.deb' | (cd ~ && sha256sum -c -); dpkg-deb -f ~/ros2-apt-source_1.3.0.noble_all.deb Package Version Architecture Depends
tail -n 8 ~/robot-setup-ros-simulation.log; grep -E '^Inst .*gazebo|^Inst .*gz-|^Inst .*ignition|^Remv ' ~/robot-setup-ros-simulation.log; grep -E '^Inst (linux-image|linux-modules|linux-raspi)' ~/robot-setup-ros-simulation.log
ps -eo pid,etime,%cpu,%mem,stat,args | grep -E 'apt-get|dpkg' | grep -v grep; tail -n 3 ~/robot-setup-ros-simulation.log; grep 'upgraded,' ~/robot-setup-ros-simulation.log; df -h /
