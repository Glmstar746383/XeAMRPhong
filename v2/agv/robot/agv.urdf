<?xml version="1.0"?>
<!--
  AGV mini - mo ta hinh hoc (URDF)
  ==================================================================
  Quy uoc truc (ROS REP-103):
    +x : tien  (mui xe)
    +y : trai
    +z : len
  Goc base_link dat tai TRUNG DIEM 2 BANH, cao bang ban kinh banh.

  So do (do thuc te 2026-11-14):
    wheel_separation : 190 mm
    wheel_diameter   :  73 mm
    body_length      : 300 mm
    body_width       : 212 mm
    lidar_height     : 230 mm
    lidar_x / y      :   0 mm / 0 mm   (ngay tren tam xe)
    camera           : mui xe, cao 130 mm, chuc xuong ~7.8 do
    front/rear       : 150 mm / 150 mm (than doi xung quanh truc banh)

  Ghi chu: cac khoi luong (mass/inertia) la gia dinh, can can lai neu
  dung cho mo phong vat ly.
-->
<robot name="agv_mini">

  <!-- ============ THAN XE ============ -->
  <link name="base_footprint"/>

  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 0.0365" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><box size="0.300 0.212 0.100"/></geometry>
      <material name="body_blue"><color rgba="0.10 0.35 0.55 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><box size="0.300 0.212 0.100"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.0120" ixy="0" ixz="0"
               iyy="0.0200" iyz="0" izz="0.0260"/>
    </inertial>
  </link>

  <!-- ============ BANH XE ============ -->
  <link name="wheel_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0365" length="0.026"/></geometry>
      <material name="wheel_black"><color rgba="0.08 0.08 0.08 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0365" length="0.026"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.00008" ixy="0" ixz="0"
               iyy="0.00010" iyz="0" izz="0.00008"/>
    </inertial>
  </link>

  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child  link="wheel_left_link"/>
    <origin xyz="0 0.095 -0.0365" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="wheel_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0365" length="0.026"/></geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0365" length="0.026"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.00008" ixy="0" ixz="0"
               iyy="0.00010" iyz="0" izz="0.00008"/>
    </inertial>
  </link>

  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child  link="wheel_right_link"/>
    <origin xyz="0 -0.095 -0.0365" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ============ LiDAR ============ -->
  <!-- Tam dau xoay dat ngay tren tam xe, cao 230 mm so voi san -->
  <link name="laser">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.040"/></geometry>
      <material name="lidar_dark"><color rgba="0.15 0.15 0.18 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.040"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.17"/>
      <inertia ixx="0.00008" ixy="0" ixz="0"
               iyy="0.00008" iyz="0" izz="0.00010"/>
    </inertial>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="laser"/>
    <origin xyz="0 0 0.1935" rpy="0 0 0"/>   <!-- 0.230 - 0.0365 -->
  </joint>

  <!-- ============ CAMERA ============ -->
  <!-- Gan o mui xe: x = 145 mm, cao 130 mm, chuc xuong ~7.8 do -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.030 0.060 0.030"/></geometry>
      <material name="cam_grey"><color rgba="0.30 0.32 0.35 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.030 0.060 0.030"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00002" ixy="0" ixz="0"
               iyy="0.00002" iyz="0" izz="0.00002"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="camera_link"/>
    <!-- 0.145 = gan mui; 0.0935 = 0.130 - 0.0365; pitch 0.136 rad = 7.8 do chuc xuong -->
    <origin xyz="0.145 0 0.0935" rpy="0 0.136 0"/>
  </joint>

  <!-- Khung quang hoc chuan ROS (z tien, x phai, y xuong) -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child  link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

</robot>
